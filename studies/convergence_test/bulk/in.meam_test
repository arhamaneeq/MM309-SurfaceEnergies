# Test the Fe-Ni-Al MEAM potential

units metal
atom_style atomic
boundary p p p

lattice fcc 3.6
region box block 0 2 0 2 0 2
create_box 3 box
create_atoms 1 box

mass 1 55.845
mass 2 58.6934
mass 3 26.9815

# Assign a mixture of Fe, Ni, and Al
set type 1 type/fraction 2 0.50 12345
set type 1 type/fraction 3 0.50 54321

# Load the MEAM potential
pair_style meam
pair_coeff * * convergence_test/potential/library.meam Fe Ni Al convergence_test/potential/FeNiAl.meam Fe Ni Al

thermo 1
thermo_style custom step atoms pe press

# Calculate energy without advancing the simulation
run 0
